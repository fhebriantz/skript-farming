# Wajib. Ambil di https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opsional. Model utama + rantai fallback (dicoba berurutan kalau kena 429/5xx).
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACKS=gemini-3.5-flash,gemini-2.5-flash,gemini-2.5-flash-lite

# --- Login ------------------------------------------------------------
# Gerbang masuk aplikasi. Wajib diisi juga di Environment Variables Vercel.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Kunci penanda tangan cookie sesi. Isi string acak panjang, mis. hasil: openssl rand -base64 32
AUTH_SECRET=
